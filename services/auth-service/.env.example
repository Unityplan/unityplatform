# Auth Service Configuration

# Server Configuration
SERVER__HOST=0.0.0.0
AUTH_SERVICE_PORT=8001

# Database Configuration
APP__DATABASE__URL=postgresql://unityplatform:unityplatform_dev_password_dk@localhost:5432/unityplatform_dk
APP__DATABASE__MAX_CONNECTIONS=20
APP__DATABASE__MIN_CONNECTIONS=5

# Redis Configuration (for rate limiting)
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_SECRET=dev_jwt_secret_please_change_in_production

# Feature Flags
ENABLE_INVITATION_VALIDATION=false  # Set to true when invitation-service is available

# Logging
RUST_LOG=auth_service=debug,actix_web=info,sqlx=warn
