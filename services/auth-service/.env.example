# Auth Service Configuration

# Server Configuration
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=8001
APP__SERVER__POD_ID=dev-pod
APP__SERVER__TERRITORY=dk
APP__SERVER__ALLOW_OPEN_REGISTRATION=true  # false for production (requires invitation token)
AUTH_SERVICE_PORT=8001

# Database Configuration
APP__DATABASE__URL=postgresql://unityplatform:unityplatform_dev_password_dk@localhost:5432/unityplatform_dk
APP__DATABASE__MAX_CONNECTIONS=20
APP__DATABASE__MIN_CONNECTIONS=5

# Redis Configuration (for rate limiting)
REDIS_URL=redis://localhost:6379

# NATS Configuration
APP__NATS__URL=nats://localhost:4222
APP__NATS__CLUSTER_NAME=unityplatform-global

# JWT Configuration (for AppConfig.auth)
APP__AUTH__JWT_SECRET=dev_jwt_secret_please_change_in_production
APP__AUTH__JWT_EXPIRATION_HOURS=24

# JWT Configuration (for auth-service)
JWT_SECRET=dev_jwt_secret_please_change_in_production

# Invitation Service Integration
INVITATION_SERVICE_URL=http://localhost:8004

# Feature Flags (DEPRECATED - use APP__SERVER__ALLOW_OPEN_REGISTRATION instead)
ENABLE_INVITATION_VALIDATION=false

# Logging
RUST_LOG=auth_service=debug,actix_web=info,sqlx=warn
