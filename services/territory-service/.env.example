APP__NATS__CLUSTER_NAME=unityplatform-global

# JWT Configuration
APP__AUTH__JWT_SECRET=dev_jwt_secret_please_change_in_production
APP__AUTH__JWT_EXPIRATION_HOURS=24

# Logging
RUST_LOG=territory_service=debug,actix_web=info,sqlx=warn
