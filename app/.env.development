# Backend Service URLs
# In development, we use the Vite Proxy (vite.config.ts) to route requests to the correct ports.
# We set these to "/" so that requests are relative to the frontend origin (localhost:5173),
# allowing the Vite proxy to intercept them.
VITE_AUTH_SERVICE_URL=/
VITE_USER_SERVICE_URL=/
VITE_INVITATION_SERVICE_URL=/
VITE_UTILITY_SERVICE_URL=/
VITE_API_URL=/
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEVTOOLS=true

