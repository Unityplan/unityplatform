# Forgejo API Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# Forgejo instance URL (without trailing slash)
FORGEJO_URL=http://localhost:3000

# Your Forgejo API token
# Generate at: Settings → Applications → Generate New Token
# Required scopes: repo (all)
FORGEJO_TOKEN=your_token_here

# Repository information
FORGEJO_OWNER=Unityplan
FORGEJO_REPO=unityplatform

# Optional: Default assignee username (leave empty for none)
DEFAULT_ASSIGNEE=

# Optional: Default milestone (leave empty for none)
DEFAULT_MILESTONE=v0.1.0-alpha.2
